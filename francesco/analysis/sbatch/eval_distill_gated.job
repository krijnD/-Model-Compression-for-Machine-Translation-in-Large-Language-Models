#!/bin/bash
#SBATCH --job-name=eval-gated
#SBATCH --partition=gpu_h100
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --output=logs/slurm-%x-%j.out

# Cheap, gated evaluation of a distilled adapter at any bit width (written for w2, docs/06-distillation.md §8).
#   1. NLL     lang_nll.py on w$BITS + adapter (500 sentences)   -> francesco/results/json/lang_nll_$TAG.json,
#              compared with lang_nll_fp16.json and lang_nll_w$BITS.json
#   2. gate    a direction in $PAIRS is generated only if its translation dNLL (vs fp16) with the adapter is
#              below $GATE nats/token (default 1.0; plain w3 was +0.64 on is-en at about half of fp16's BLEU)
#   3. generate the passing directions on the repacked w$BITS (4-bit container, ExllamaV2; docs/04-kernel-repack.md)
#              + adapter -> outputs/$KD_RUN/wmt22
#   4. score   BLEU / chrF++ / hallucination vs fp16 (ours-beam) and the scored grid run gptq-w${BITS}g128, plus
#              XCOMET-XXL of the new outputs -> francesco/results/json/distill_$TAG.json, outputs/xcomet-xxl/$KD_RUN/
#   SKIP_XCOMET=1 : skip XCOMET-XXL (for a 40 GB A100: --partition=gpu_a100); xcomet_xxl is then null in the JSON
# No plain w$BITS-as4 generation: for w2 the grid run is already at BLEU ~0, so kernel drift can't matter there
# (unlike w3, where eval_distill.job compares against w3-as4).
#   sbatch --export=ALL,BITS=2,TAG=w2kd-r64,KD_RUN=gptq-w2g128-as4-kd-r64,ADAPTER=/scratch-shared/$USER/models/ALMA-13B-R-gptq-w2g128-kd-lora-r64 \
#          francesco/analysis/sbatch/eval_distill_gated.job
set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
VENV=venv-quant
source scripts/snellius/env.sh
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export CUDA_DEVICE_ORDER=PCI_BUS_ID

MODELS_SCRATCH="/scratch-shared/$USER/models"
BITS="${BITS:?set BITS}"
ADAPTER="${ADAPTER:?set ADAPTER}"
TAG="${TAG:-w${BITS}kd}"
KD_RUN="${KD_RUN:-gptq-w${BITS}g128-as4-kd}"
PAIRS="${PAIRS:-is-en,de-en}"
GATE="${GATE:-1.0}"
QMODEL="$PROJECT_DIR/models/ALMA-13B-R-gptq-w${BITS}g128"
AS4="$MODELS_SCRATCH/ALMA-13B-R-gptq-w${BITS}g128-as-w4"
J="$REPO_DIR/francesco/results/json"
OUT="$OUTPUT_ROOT/$KD_RUN/wmt22"
[ -f "$ADAPTER/adapter.safetensors" ] || { echo "ERROR: no adapter in $ADAPTER"; exit 1; }

echo "##### 1/4 NLL w$BITS + adapter ($(date))"
python francesco/analysis/lang_nll.py --model "$QMODEL" --quantized --adapter "$ADAPTER" --tag "$TAG" \
  --limit 500 --out "$J/lang_nll_$TAG.json"
python francesco/analysis/lang_nll.py --compare "$J/lang_nll_fp16.json" "$J/lang_nll_w$BITS.json" "$J/lang_nll_$TAG.json"

echo "##### 2/4 gate: translation dNLL < $GATE ($(date))"
PASS=$(python - "$J/lang_nll_fp16.json" "$J/lang_nll_$TAG.json" "$PAIRS" "$GATE" <<'EOF'
import json, sys
fp, kd = (json.load(open(p))["nll"] for p in sys.argv[1:3])
ok = []
for pair in sys.argv[3].split(","):
    d = kd[f"trans:{pair}"] - fp[f"trans:{pair}"]
    print(f"{pair}: dNLL {d:+.3f} -> {'generate' if d < float(sys.argv[4]) else 'skip'}", file=sys.stderr)
    if d < float(sys.argv[4]):
        ok.append(pair)
print(",".join(ok))
EOF
)
[ -z "$PASS" ] && { echo "##### gate: no direction passed, stopping ($(date))"; exit 0; }

echo "##### 3/4 generate $KD_RUN: $PASS ($(date))"
python francesco/analysis/generate_lora.py --model "$AS4" --adapter "$ADAPTER" --pairs "$PASS" --out "$OUT" \
  --max-source-length 256 --batch-size 4 --max-new-tokens 256 --num-beams 5

echo "##### 4/4 score ($(date))"
source "$PROJECT_DIR/venv/bin/activate"
R="$OUTPUT_ROOT/xcomet-xxl/$KD_RUN"; mkdir -p "$R"
if [ "${SKIP_XCOMET:-0}" = 1 ]; then
  echo "SKIP_XCOMET=1: no XCOMET-XXL (it needs ~43 GB, more than an A100 has); score later on an H100:"
  echo "  for p in ${PASS//,/ }; do comet-score -s <src> -t $OUT/test-\$p --model Unbabel/XCOMET-XXL ... > $R/\$p.txt; done"
else
  for pair in ${PASS//,/ }; do
    comet-score -s "$(src_path "$pair")" -t "$OUT/test-$pair" --model Unbabel/XCOMET-XXL --batch_size 8 --gpus 1 \
      --to_json "$R/$pair.json" > "$R/$pair.txt"
  done
fi
python - "$PASS" "$BITS" "$KD_RUN" "$J/distill_$TAG.json" <<'EOF'
import json, re, sys
from pathlib import Path
from sacrebleu.metrics import BLEU, CHRF
pairs, bits, kd_run, out = sys.argv[1].split(","), sys.argv[2], sys.argv[3], sys.argv[4]
O = Path("../outputs"); T = Path("third_party/ALMA/outputs/wmt22_outputs/wmt-testset")
runs = {"fp16": "alma-13b-r-beam", f"w{bits} grid": f"gptq-w{bits}g128", f"w{bits}+KD": kd_run}
xc_dir = {"fp16": "ours-beam", f"w{bits} grid": f"gptq-w{bits}g128", f"w{bits}+KD": kd_run}
res = {}
for pair in pairs:
    s, t = pair.split("-")
    ref = (T / f"{s}{t}/test.{pair}.{t}").read_text(encoding="utf-8").splitlines()
    for name, run in runs.items():
        h = (O / run / "wmt22" / f"test-{pair}").read_text(encoding="utf-8").splitlines()
        xf = O / "xcomet-xxl" / xc_dir[name] / f"{pair}.txt"
        xm = re.findall(r"score: ([0-9.]+)", xf.read_text()) if xf.exists() else []
        res.setdefault(pair, {})[name] = {
            "bleu": round(BLEU(tokenize="zh" if t == "zh" else "13a").corpus_score(h, [ref]).score, 2),
            "chrf++": round(CHRF(word_order=2).corpus_score(h, [ref]).score, 2),
            "halluc_pct": round(100 * sum(len(x) >= 2 * len(r) for x, r in zip(h, ref)) / len(h), 2),
            "xcomet_xxl": round(100 * float(xm[-1]), 2) if xm else None}
    r = res[pair]; fp, q, kd = r["fp16"], r[f"w{bits} grid"], r[f"w{bits}+KD"]
    for m in ("bleu", "xcomet_xxl"):
        if None not in (fp[m], q[m], kd[m]) and fp[m] != q[m]:
            r[f"recovered_{m}"] = round((kd[m] - q[m]) / (fp[m] - q[m]), 3)
    print(pair, json.dumps(r, indent=1))
json.dump(res, open(out, "w"), indent=1)
EOF
echo "##### done ($(date))"
