#!/bin/bash
#SBATCH --job-name=xcomet
#SBATCH --partition=gpu_h100
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --time=01:00:00
#SBATCH --output=logs/slurm-%x-%j.out

# XCOMET-XXL (no reference, x100, as the ALMA-R paper and score_comet.job) for a subset of directions of one run.
# For runs generated where XCOMET-XXL doesn't fit (40 GB A100). Needs an H100.
# Output: $OUTPUTS_DIR/xcomet-xxl/$KD_RUN/<pair>.{json,txt}. Directions already scored are skipped.
#   KD_RUN=gptq-w2g128-as4-kd-r64 PAIRS=is-en,de-en sbatch --export=ALL slurm/score_xcomet.job
# (KD_RUN, not RUN: env.sh already sets RUN.)
set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
source slurm/env.sh   # scoring venv (comet)

KD_RUN="${KD_RUN:?set KD_RUN, the folder in $OUTPUTS_DIR}"
PAIRS="${PAIRS:?set PAIRS, e.g. is-en,de-en}"
PAIRS="${PAIRS//:/,}"   # also accept a:b:c. A comma list inside sbatch --export=... is SPLIT into separate
                        # variables (only the first pair survives): pass PAIRS via the environment or with ":"
R="$OUTPUTS_DIR/xcomet-xxl/$KD_RUN"; mkdir -p "$R"
for pair in ${PAIRS//,/ }; do
  hyp="$OUTPUTS_DIR/$KD_RUN/wmt22/test-$pair"
  [ -f "$hyp" ] || { echo "ERROR: missing $hyp"; exit 1; }
  grep -q "score:" "$R/$pair.txt" 2>/dev/null && { echo "Skipping $pair: already scored"; continue; }
  echo "=== XCOMET-XXL $KD_RUN $pair ($(date))"
  comet-score -s "$(src_path "$pair")" -t "$hyp" --model Unbabel/XCOMET-XXL --batch_size 8 --gpus 1 \
    --to_json "$R/$pair.json" > "$R/$pair.txt"
  awk -v p="$pair" '/score:/{s=$NF} END{printf "%s\t%.2f\n", p, s*100}' "$R/$pair.txt"
done
echo "##### done ($(date))"
