#!/bin/bash
#SBATCH --job-name=lang-nll
#SBATCH --partition=gpu_h100
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --time=02:00:00
#SBATCH --output=logs/slurm-%x-%j.out

# Teacher-forced NLL per language (paper Section 3.2, Figure 5): monolingual text vs reference translation,
# for fp16 and every GPTQ checkpoint. For the adapters, use gen_lora.job with NLL=1.
# Forward passes only, no generation. Submit from the repo root:
#   sbatch slurm/lang_nll.job
#   sbatch --export=ALL,LIMIT=32 slurm/lang_nll.job    # smoke test
set -euo pipefail
VENV=venv-quant      # GPTQModel for the quantized folders; its transformers also loads fp16
source slurm/env.sh
J=$REPO_DIR/results/json
LIMIT=${LIMIT:-500}

python scripts/analysis/lang_nll.py --model "$MODELS_DIR/ALMA-13B-R" --tag fp16 \
  --limit "$LIMIT" --out "$J/lang_nll_fp16.json"
for b in 8 4 3 2; do
  python scripts/analysis/lang_nll.py --model "$MODELS_DIR/ALMA-13B-R-gptq-w${b}g128" \
    --quantized --tag "w$b" --limit "$LIMIT" --out "$J/lang_nll_w$b.json"
done
python scripts/analysis/lang_nll.py --compare $J/lang_nll_fp16.json $J/lang_nll_w{8,4,3,2}.json
