#!/bin/bash
#SBATCH --job-name=gptq-quant
#SBATCH --partition=gpu_h100
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --output=logs/slurm-%x-%A_%a.out

# GPTQ-quantize ALMA-13B-R (all decoder-layer Linears; embeddings, RMSNorms and lm_head stay fp16).
# One bit width per array task; the array index is the bit width:
#   sbatch --array=2,3,4,8 slurm/quantize_gptq.job
#   -> <project dir>/models/ALMA-13B-R-gptq-w{2,3,4,8}g128
# Other settings go through QUANT_ARGS (flags of scripts/quantize/quantize_gptq.py), e.g.
#   sbatch --array=4 --export=ALL,QUANT_ARGS="--group-size -1 --sym" slurm/quantize_gptq.job

set -euo pipefail
VENV=venv-quant
source slurm/env.sh

BITS="${SLURM_ARRAY_TASK_ID:-${BITS:-4}}"
echo "Bits: $BITS | extra args: ${QUANT_ARGS:-none}"
python scripts/quantize/quantize_gptq.py \
  --model "${MODEL:-$PROJECT_DIR/models/ALMA-13B-R}" \
  --out-root "$PROJECT_DIR/models" \
  --bits "$BITS" \
  ${QUANT_ARGS:-}
